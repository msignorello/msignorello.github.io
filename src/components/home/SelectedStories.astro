---
interface Story {
  number: string;
  title: string;
  summary: string;
  metadata: string[];
  href: string;
  accent: string;
}

interface Props {
  stories: Story[];
}

const { stories } = Astro.props;
---

<section
  class="home-section stories-section"
  id="stories"
  aria-labelledby="stories-title"
  data-analytics-location="selected_stories"
>
  <div class="stories-heading">
    <div>
      <p class="eyebrow">Selected stories</p>
      <h2 id="stories-title">The interesting part is what changed.</h2>
    </div>
    <p>
      A few examples of the systems, teams, and platforms I have helped move forward.
      The full chronology lives in the résumé.
    </p>
  </div>
  <div class="story-list">
    {stories.map((story) => (
      <a
        class={`story-row story-${story.accent}`}
        href={story.href}
        data-analytics-label={story.title}
      >
        <div class="story-topline">
          <span class="story-number" aria-hidden="true">{story.number}</span>
          <div class="story-meta">
            {story.metadata.map((item) => <span>{item}</span>)}
          </div>
          <span class="story-arrow" aria-hidden="true">↗</span>
        </div>
        <div class="story-copy">
          <h3>{story.title}</h3>
          <p>{story.summary}</p>
        </div>
      </a>
    ))}
  </div>
</section>
