---

<BaseLayout
  title="Product Organization & Technology Leadership Resume - Matt Signorello"
  description="Matt Signorello's resume: product organization leadership, digital platforms, connected vehicle technology, engineering management, SaaS implementation, and operating-model design."
  schema={{
    "@type": "WebPage",
    "@id": "https://mattsignorello.com/resume/#webpage",
    url: "https://mattsignorello.com/resume/",
    name: "Product Organization and Technology Leadership Resume - Matt Signorello",
    about: { "@id": "https://mattsignorello.com/#person" },
    isPartOf: { "@id": "https://mattsignorello.com/#website" }
  }}
>
  <main class="wrap">
    <header class="page-header">
      <p class="eyebrow">Resume</p>
      <h1>Product organization and technology leadership.</h1>
      <p class="section-copy">
        I build product teams, operating models, digital platforms, and delivery
        systems across global enterprises, connected vehicles, SaaS, and small
        business environments.
      </p>
    </header>

    <section class="section resume-experience">
      <div class="resume-section-head">
        <p class="eyebrow">Experience</p>
        <h2>Professional timeline.</h2>
        <p class="section-copy">
          Roles where product strategy, engineering, operations, customer experience,
          and hands-on technology came together.
        </p>
      </div>
      <div class="resume-timeline">
        {experience.map((item) => (
          <article class="resume-card" id={item.id}>
            <div class="resume-card-meta">
              <span class="resume-date">{item.dates}</span>
              <div class="resume-company">
                {item.logo ? (
                  <img
                    src={item.logo}
                    alt={`${item.place} logo`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="resume-logo-fallback">{item.logoText ?? item.place.charAt(0)}</span>
                )}
                <h3>{item.place}</h3>
              </div>
            </div>
            <div class="resume-card-copy">
              <p class="resume-title">{item.title}</p>
              <p>{item.detail}</p>
              {item.highlights && (
                <ul>
                  {item.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-grid section">
      <div>
        <p class="eyebrow">Education</p>
        <h2>Formal background.</h2>
      </div>
      <div class="service-list">
        {education.map((item) => (
          <article class="service">
            <div class="code">{item.dates.slice(0, 4)}</div>
            <div>
              <h3>{item.place}</h3>
              <p><strong>{item.title}</strong></p>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-grid section">
      <div>
        <p class="eyebrow">Skills</p>
        <h2>Core competencies.</h2>
      </div>
      <div class="skill-cloud">
        {competencies.map((skill) => <span>{skill}</span>)}
      </div>
    </section>

    <section class="section-grid section">
      <div>
        <p class="eyebrow">Certificates</p>
        <h2>Credentials and training.</h2>
      </div>
      <div class="service-list">
        {certificates.map((item) => (
          <article class="service">
            <div class="code">{item.code}</div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
